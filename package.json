{
  "name": "kalendaria",
  "version": "1.1.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-vector-icons/ionicons": "^14.0.0",
    "@supabase/supabase-js": "^2.118.0",
    "date-fns": "^4.4.0",
    "expo": "~58.0.24",
    "expo-constants": "~58.0.13",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.8",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.31",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/register.mjs --test-reporter=spec --test \"tests/*.test.ts\"",
    "landing": "node landing/dev-server.mjs",
    "doctor": "npx expo-doctor",
    "check": "npm run typecheck && npm test",
    "build:preview": "eas build --platform android --profile preview",
    "build:apk": "eas build --platform android --profile production-apk",
    "build:aab": "eas build --platform android --profile production",
    "release:verify": "bash scripts/verify-apk.sh",
    "db:backup": "bash scripts/backup-db.sh"
  },
  "private": true,
  "overrides": {
    "react-dom": "19.3.0"
  }
}
